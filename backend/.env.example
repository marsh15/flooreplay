FLOORREPLAY_DATABASE_URL=postgresql+psycopg://localhost:5433/flooreplay
FLOORREPLAY_MODE=local
FLOORREPLAY_BUILD_ID=dev
# Optional: enables the pinned OpenAI structured parser. Without a key the
# offline rule-baseline parser runs and every surface still works.
#FLOORREPLAY_OPENAI_API_KEY=
# Public demo limits (public mode only): replay executions per client per hour.
#FLOORREPLAY_PUBLIC_REPLAYS_PER_HOUR=20
# Comma-separated browser origins allowed to call the API from a deployed
# frontend, e.g. https://flooreplay-frontend.onrender.com
#FLOORREPLAY_CORS_ORIGINS=["https://flooreplay-frontend.onrender.com"]
