FLOORREPLAY_DATABASE_URL=postgresql+psycopg://localhost:5433/flooreplay
FLOORREPLAY_MODE=local
FLOORREPLAY_BUILD_ID=dev
# Optional provider key belongs only to the backend. Never use VITE_ for a key.
FLOORREPLAY_OPENAI_API_KEY=
FLOORREPLAY_OPENAI_GENERATION_MODEL=gpt-4.1-mini-2025-04-14
FLOORREPLAY_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
FLOORREPLAY_OPENAI_EMBEDDING_DIMENSIONS=512
# Fixed accounting conversion, not a live exchange-rate quote.
FLOORREPLAY_OPENAI_INR_PER_USD=90
# Exact deployed frontend origin. Empty is allowed for Vite's same-origin proxy.
FLOORREPLAY_CORS_ORIGINS=[]
FLOORREPLAY_PUBLIC_REPLAYS_PER_HOUR=20
# Test commands override DATABASE_URL with a separate _test database.
# FLOORREPLAY_TEST_DATABASE_URL=postgresql+psycopg://localhost:5433/flooreplay_release_test
